{
  "name": "@superlucky84/ddd-docmap",
  "version": "0.0.0-dev.0",
  "description": "Local document maps for Doc-Driven Development projects.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "ddd-docmap": "./bin/ddd-docmap.js"
  },
  "files": [
    "AGENTS.md",
    "bin/",
    "src/",
    "docs/"
  ],
  "scripts": {
    "check": "node scripts/check.js",
    "test": "node --test --test-reporter=spec test/*.test.js",
    "test:browser": "playwright test",
    "test:integration": "node --test --test-reporter=spec test/integration/*.test.js",
    "benchmark": "node scripts/benchmark.js"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superlucky84/ddd-docmap.git"
  },
  "bugs": {
    "url": "https://github.com/superlucky84/ddd-docmap/issues"
  },
  "homepage": "https://github.com/superlucky84/ddd-docmap#readme",
  "keywords": [
    "doc-driven-development",
    "documentation",
    "markdown",
    "cli"
  ],
  "dependencies": {
    "chokidar": "5.0.0",
    "github-slugger": "2.0.0",
    "ignore": "7.0.14",
    "markdown-it": "15.0.3",
    "mdast-util-from-markdown": "2.1.0",
    "open": "10.2.0",
    "picomatch": "4.0.7"
  },
  "exports": {
    ".": "./src/collector/index.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
