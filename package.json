{
  "name": "docatlas",
  "version": "0.4.1",
  "description": "Doc-Driven Development toolkit: agent skills for Claude Code and Codex, and a local map of your project documents.",
  "license": "MIT",
  "author": "superlucky84",
  "type": "module",
  "bin": {
    "docatlas": "bin/docatlas.js",
    "docmap": "bin/docatlas.js",
    "ddd-docmap": "bin/docatlas.js"
  },
  "files": [
    "agent-kit/",
    "bin/",
    "src/"
  ],
  "scripts": {
    "check": "node scripts/check.js",
    "test": "node --test --test-reporter=spec test/*.test.js",
    "test:browser": "playwright test",
    "test:integration": "node --test --test-reporter=spec test/integration/*.test.js",
    "test:platform": "node --test --test-reporter=spec test/platform.test.js test/language-projects.test.js",
    "benchmark": "node scripts/benchmark.js"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superlucky84/docatlas.git"
  },
  "bugs": {
    "url": "https://github.com/superlucky84/docatlas/issues"
  },
  "homepage": "https://github.com/superlucky84/docatlas#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "doc-driven-development",
    "documentation",
    "markdown",
    "cli",
    "ai-agents",
    "agent-skills",
    "claude-code",
    "codex",
    "document-map"
  ],
  "dependencies": {
    "chokidar": "5.0.0",
    "github-slugger": "2.0.0",
    "ignore": "7.0.14",
    "markdown-it": "15.0.3",
    "mdast-util-from-markdown": "2.1.0",
    "open": "10.2.0",
    "picomatch": "4.0.7"
  },
  "exports": {
    ".": "./src/collector/index.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
